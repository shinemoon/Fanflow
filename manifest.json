{
	"name": "饭否 FanFlow",
	"version": "1.0.2",
	"description": "Fanfou 饭否 插件 for browser",
	"short_name": "FFlow",
	"manifest_version": 3,
	"icons": {
		"48": "images/icon.png",
		"128": "images/icon.png"
	},
	"action": {
		"default_icon": "images/icon.png",
		"default_popup": "popup.html",
		"default_title": "FanFlow"
	},
	"host_permissions": [
		"http://fanfou.com/*",
		"http://api.fanfou.com/*"
	],
	"permissions": [
		"storage",
		"alarms"
	],
	"background": {
		"service_worker": "background.js"
	}
}